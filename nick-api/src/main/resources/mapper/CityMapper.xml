<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.nick.api.mapper.CityMapper">
    <!-- findCity 已改用 MyBatis-Plus selectList，不再需要 XML -->
    <!--    keyColumn指定数据库表中生成主键的列名,keyProperty: 指定将生成的主键值映射到 Java 对象的哪个属性,
            他两的值可以不相同,但一般是一样的-->
    <insert id="addCity" useGeneratedKeys="true" keyColumn="id" keyProperty="id">
        INSERT INTO metro_city(name, code)
        VALUES (#{name}, #{code})
    </insert>
    <update id="updateCity">
        UPDATE metro_city
        SET lng = #{lng},
            lat = #{lat}
        WHERE name = #{name}
    </update>
    <delete id="deleteCity">
        DELETE
        FROM metro_city
        WHERE id = #{id}
    </delete>
</mapper>
